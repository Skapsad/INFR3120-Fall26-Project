<%- include partials/header.ejs %>
<%- include partials/main_nav.ejs %>

<main class="container">
<h1>Find Your Quiet Study Spot</h1>
<p>Find suitable places on campus to study based on noise levels, crowd levels and power outlet availability.</p>
<!-- Button to report a study spot -->
<a class="btn btn-primary" href="/spots/add">Report a Study Spot</a>
<br>
<br>
<!-- Study spot listing -->
<h2>Available Study Spots</h2>

<table class="table table-bordered table-striped table-hover">
    <!-- Header Row -->
    <tr>
        <th class="text-center col-3">Location</th>
        <th class="text-center col-3">Noise Level</th>
        <th class="text-center col-3">Crowd Level</th>
        <th class="text-center col-3">Power Outlets</th>
        <th class="text-center col-3">Time Left</th>
    </tr>

    <!-- Display each study spot record -->
    <% for(let count=0;count<Spotlist.length;count++) { %>
        <tr>
            <td class="text-center col-3"><%= Spotlist[count].location %></td>
            <td class="text-center col-3"><%= Spotlist[count].noiseLevel %></td>
            <td class="text-center col-3"><%= Spotlist[count].crowdLevel %></td>
            <td class="text-center col-3"><%= Spotlist[count].powerOutlets %></td>
            <td class="text-center">
              <% if (Spotlist[count].expiresAt) { %>
                <span class="spot-countdown"
                      data-expires-at="<%= Spotlist[count].expiresAt %>"></span>
              <% } else { %>
                -
              <% } %>
            </td>
        </tr>
    <% } %>
</table>
</main>

<script>
  function updateCountdowns() {
    document.querySelectorAll('.spot-countdown').forEach(function (timer) {
      const expiresAt = Number(timer.dataset.expiresAt);
      const secondsLeft = Math.ceil((expiresAt - Date.now()) / 1000);

      if (secondsLeft <= 0) {
        timer.closest('tr').remove();
        return;
      }

      const minutes = Math.floor(secondsLeft / 60);
      const seconds = String(secondsLeft % 60).padStart(2, '0');
      timer.textContent = minutes + ':' + seconds;
    });
  }

  updateCountdowns();
  setInterval(updateCountdowns, 1000);
</script>

<%- include partials/footer.ejs %>
